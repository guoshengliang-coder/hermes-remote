+_DISPLAY_IMAGE_KINDS = frozenset({"image_url", "input_image", "image"})
+
+
+def _without_inline_image_data(message: dict) -> dict:
+    """``message`` with inline ``data:`` image payloads replaced by a placeholder.
+
+    The stored row keeps them; this projection is display-only and is what a remote client reads.
+    One session measured 27,479,595 characters in a single message, 75 base64 images, against 6,374
+    once they are dropped — and no client of this endpoint decodes them, because the image bytes are
+    fetched separately by path. An ``https://`` URL is left alone: it is small and still fetchable.
+    """
+    content = message.get("content")
+    if not isinstance(content, list):
+        return message
+    parts, changed = [], False
+    for part in content:
+        url = part.get("image_url") if isinstance(part, dict) else None
+        actual = url.get("url") if isinstance(url, dict) else url
+        if (isinstance(part, dict) and part.get("type") in _DISPLAY_IMAGE_KINDS
+                and isinstance(actual, str) and actual.startswith("data:")):
+            replaced = dict(part)
+            replaced["image_url"] = {**url, "url": "[image]"} if isinstance(url, dict) else "[image]"
+            parts.append(replaced)
+            changed = True
+            continue
+        parts.append(part)
+    if not changed:
+        return message
+    projected = message.copy()
+    projected["content"] = parts
+    return projected
+
+
 def _project_for_display(messages: list) -> list:
