Upstream-Issue: https://github.com/NousResearch/hermes-agent/issues/116510
Why-upstream-will-not: expected to land upstream since this is a plain robustness defect, so delete this patch once it does; carried meanwhile because sessions written after a newer Hermes migrated the shared database cannot be opened at all
Read-side-only: yes
Added: 2026-09-20

diff --git a/hermes_state_messages.py b/hermes_state_messages.py
index 9f09886b5f..dfe2c4d4e3 100644
--- a/hermes_state_messages.py
+++ b/hermes_state_messages.py
@@ -93,6 +93,18 @@ def _stale_holder(row, now: float) -> bool:
     return float(row["expires_at"]) <= now or _compression_lock_holder_process_is_dead(row["holder"])
 
 
+
+# Columns `_row_to_message_dict` will hand on. Anything else the schema grows stays in the database.
+# Keep this in step with the message dict's consumers, not with the table: the table may legitimately
+# carry bookkeeping the API has no business returning.
+_MESSAGE_DICT_COLUMNS = frozenset({
+    "id", "session_id", "role", "content", "tool_call_id", "tool_calls", "tool_name",
+    "effect_disposition", "timestamp", "token_count", "finish_reason", "reasoning",
+    "reasoning_content", "reasoning_details", "codex_reasoning_items", "codex_message_items",
+    "platform_message_id", "observed", "active", "compacted", "api_content", "display_kind",
+    "display_metadata", "_compressed_summary",
+})
+
 class SessionMessagesMixin:
     """Message append/replace/rewind, reactions, resume conversations, replay dedupe."""
 
@@ -608,8 +620,19 @@ class SessionMessagesMixin:
 
     def _row_to_message_dict(self, row, *, warn_context: str, summary_flag: bool) -> Dict[str, Any]:
         """``dict(row)`` with content/tool_calls/display_metadata decoded; *summary_flag* keeps
-        ``_compressed_summary`` only as ``True``."""
-        msg = dict(row)
+        ``_compressed_summary`` only as ``True``.
+
+        Columns this code does not know about are dropped rather than passed through. A row read
+        with ``SELECT *`` carries whatever the schema happens to hold, and this dict is handed to
+        the API's response encoder — so a column added by a newer Hermes sharing the same database
+        reaches JSON serialization unexamined. On 2026-09-19 a ``display_identity BLOB`` did exactly
+        that: ``bytes`` has no JSON form, the encoder called ``.decode()`` on a 32-byte digest, and
+        every affected transcript answered 500 with a traceback naming only FastAPI frames.
+
+        The allowlist is the shape the readers of this dict already expect, so dropping the rest
+        changes nothing for them and makes a future column harmless by construction.
+        """
+        msg = {key: value for key, value in dict(row).items() if key in _MESSAGE_DICT_COLUMNS}
         if summary_flag and msg.pop("_compressed_summary", 0):
             msg["_compressed_summary"] = True
         msg["content"] = self._decode_content(msg["content"])
