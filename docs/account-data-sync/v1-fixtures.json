{
  "specVersion": 1,
  "status": "p0-test-only",
  "principals": {
    "a": {"origin": "https://sync.invalid", "accountId": "account-a"},
    "b": {"origin": "https://sync.invalid", "accountId": "account-b"},
    "otherOrigin": {"origin": "https://other.invalid", "accountId": "account-a"}
  },
  "entities": {
    "pin": {"kind": "pin", "deviceId": "mac-a", "profile": "default", "sessionId": "same-session", "sessionEpoch": "epoch-1"},
    "pinOtherMac": {"kind": "pin", "deviceId": "mac-b", "profile": "default", "sessionId": "same-session", "sessionEpoch": "epoch-1"},
    "read": {"kind": "read", "deviceId": "mac-a", "profile": "default", "sessionId": "same-session", "sessionEpoch": "epoch-1"},
    "favorite": {"kind": "favorite", "provider": "example-provider", "model": "family/model"}
  },
  "traces": [
    {
      "name": "android-pin-web-unpin-stale-android-replay",
      "steps": [
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": true, "expect": "1"},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "android-1", "accessGeneration": "1", "baseRevision": "0", "value": true, "expect": {"status": "accepted", "revision": "1", "value": true}},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "web-1", "accessGeneration": "1", "baseRevision": "1", "value": false, "expect": {"status": "accepted", "revision": "2", "value": false}},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "android-1", "accessGeneration": "1", "baseRevision": "0", "value": true, "expect": {"status": "accepted", "revision": "1", "value": true}},
        {"action": "visible", "actor": "a", "expectValues": [false], "expectRevision": "2"}
      ]
    },
    {
      "name": "two-phones-and-web-read-out-of-order",
      "steps": [
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": true, "expect": "1"},
        {"action": "observe", "actor": "a", "entity": "read", "accessGeneration": "1", "through": "12", "saveAs": "phone-a"},
        {"action": "observe", "actor": "a", "entity": "read", "accessGeneration": "1", "through": "10", "saveAs": "phone-b"},
        {"action": "mutate", "actor": "a", "entity": "read", "opId": "read-a", "accessGeneration": "1", "observationRef": "phone-a", "expect": {"status": "accepted", "revision": "1", "value": "12"}},
        {"action": "mutate", "actor": "a", "entity": "read", "opId": "read-b", "accessGeneration": "1", "observationRef": "phone-b", "expect": {"status": "accepted", "revision": "1", "value": "12"}},
        {"action": "visible", "actor": "a", "expectValues": ["12"], "expectRevision": "1"}
      ]
    },
    {
      "name": "revocation-rejects-cached-success-and-regrant-does-not-restore",
      "steps": [
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": true, "expect": "1"},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "old-pin", "accessGeneration": "1", "baseRevision": "0", "value": true, "expect": {"status": "accepted", "revision": "1", "value": true}},
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": false, "expect": "2"},
        {"action": "visible", "actor": "a", "expectValues": [], "expectRevision": "1"},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "old-pin", "accessGeneration": "1", "baseRevision": "0", "value": true, "expect": {"status": "denied"}},
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": true, "expect": "3"},
        {"action": "visible", "actor": "a", "expectValues": [], "expectRevision": "1"},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "new-pin", "accessGeneration": "3", "baseRevision": "0", "value": false, "expect": {"status": "accepted", "revision": "2", "value": false}}
      ]
    },
    {
      "name": "personal-pins-do-not-cross-account-or-origin",
      "steps": [
        {"action": "access", "actor": "a", "deviceId": "mac-a", "active": true, "expect": "1"},
        {"action": "access", "actor": "b", "deviceId": "mac-a", "active": true, "expect": "1"},
        {"action": "mutate", "actor": "a", "entity": "pin", "opId": "private", "accessGeneration": "1", "baseRevision": "0", "value": true, "expect": {"status": "accepted", "revision": "1", "value": true}},
        {"action": "visible", "actor": "b", "expectValues": [], "expectRevision": "0"},
        {"action": "visible", "actor": "otherOrigin", "expectValues": [], "expectRevision": "0"}
      ]
    }
  ],
  "contentCounterexamples": [
    {
      "name": "in-place-body-edit-retains-id-count-and-time",
      "before": {"lastActive": 100, "messages": [{"id": 7, "timestamp": 100, "content": "first body"}]},
      "after": {"lastActive": 100, "messages": [{"id": 7, "timestamp": 100, "content": "changed body"}]}
    },
    {
      "name": "older-row-edit-retains-the-latest-page",
      "before": {"lastActive": 100, "messages": [{"id": 1, "timestamp": 90, "content": "older body"}, {"id": 7, "timestamp": 100, "content": "last body"}]},
      "after": {"lastActive": 100, "messages": [{"id": 1, "timestamp": 90, "content": "edited older body"}, {"id": 7, "timestamp": 100, "content": "last body"}]}
    }
  ]
}
