{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermesgo.invalid/schemas/gateway-environment-v1.json",
  "title": "Hermes GO Gateway environment",
  "description": "Environment contract for Gateway Server Release R2. Secret values may be supplied directly or through the corresponding _FILE property.",
  "type": "object",
  "properties": {
    "NODE_ENV": { "type": "string", "enum": ["development", "test", "production"] },
    "HOST": { "type": "string", "minLength": 1 },
    "PORT": { "$ref": "#/$defs/port" },
    "APP_TOKEN": { "$ref": "#/$defs/secret8" },
    "APP_TOKEN_FILE": { "$ref": "#/$defs/path" },
    "CONNECTOR_TOKEN": { "$ref": "#/$defs/secret8" },
    "CONNECTOR_TOKEN_FILE": { "$ref": "#/$defs/path" },
    "INTERNAL_STATUS_TOKEN": { "$ref": "#/$defs/secret16" },
    "INTERNAL_STATUS_TOKEN_FILE": { "$ref": "#/$defs/path" },
    "TLS_CERT_FILE": { "$ref": "#/$defs/path" },
    "TLS_KEY_FILE": { "$ref": "#/$defs/path" },
    "DEFAULT_DEVICE_ID": { "type": "string", "minLength": 1, "maxLength": 128 },
    "MAX_BODY_BYTES": { "$ref": "#/$defs/positiveInteger" },
    "REQUEST_TIMEOUT_MS": { "$ref": "#/$defs/positiveInteger" },
    "MAX_PENDING_REQUESTS": { "$ref": "#/$defs/positiveInteger" },
    "MAX_WS_TUNNELS": { "$ref": "#/$defs/positiveInteger" },
    "MAX_CONTROL_CONNECTIONS": { "$ref": "#/$defs/positiveInteger" },
    "MAX_WIRE_PAYLOAD_BYTES": { "$ref": "#/$defs/positiveInteger" },
    "MAX_APP_WS_PAYLOAD_BYTES": { "$ref": "#/$defs/positiveInteger" },
    "MAX_SOCKET_BUFFERED_BYTES": { "$ref": "#/$defs/positiveInteger" },
    "LIFECYCLE_EVENT_STORE_FILE": { "$ref": "#/$defs/path" },
    "MAX_LIFECYCLE_EVENTS": { "$ref": "#/$defs/positiveInteger" },
    "ACCOUNT_AUTH_ENABLED": { "$ref": "#/$defs/booleanFlag" },
    "ACCOUNT_BINDING_ENABLED": { "$ref": "#/$defs/booleanFlag" },
    "ACCOUNT_DATABASE_URL": { "$ref": "#/$defs/secret8" },
    "ACCOUNT_DATABASE_URL_FILE": { "$ref": "#/$defs/path" },
    "ACCOUNT_DATABASE_SSL": { "$ref": "#/$defs/booleanFlag" },
    "ACCOUNT_DATABASE_POOL_SIZE": { "$ref": "#/$defs/positiveInteger" },
    "ACCOUNT_DATABASE_CONNECT_TIMEOUT_MS": { "$ref": "#/$defs/positiveInteger" },
    "ACCOUNT_TOKEN_HASH_KEY": { "$ref": "#/$defs/secret32" },
    "ACCOUNT_TOKEN_HASH_KEY_FILE": { "$ref": "#/$defs/path" },
    "ACCOUNT_GOOGLE_ANDROID_CLIENT_ID": { "$ref": "#/$defs/secret8" },
    "ACCOUNT_GOOGLE_ANDROID_CLIENT_ID_FILE": { "$ref": "#/$defs/path" },
    "ACCOUNT_GOOGLE_MACOS_CLIENT_ID": { "$ref": "#/$defs/secret8" },
    "ACCOUNT_GOOGLE_MACOS_CLIENT_ID_FILE": { "$ref": "#/$defs/path" },
    "ACCOUNT_GATEWAY_ORIGIN": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "ACCOUNT_TRUST_LOOPBACK_PROXY": { "$ref": "#/$defs/booleanFlag" },
    "ACCOUNT_MAX_PENDING_CONNECTOR_PROOFS": { "$ref": "#/$defs/positiveInteger" },
    "ACCOUNT_MAX_UNAUTHENTICATED_CONNECTORS": { "$ref": "#/$defs/positiveInteger" },
    "ACCOUNT_MAX_UNAUTHENTICATED_CONNECTORS_PER_IP": { "$ref": "#/$defs/positiveInteger" },
    "MAX_ACCOUNT_LIFECYCLE_EVENTS": { "$ref": "#/$defs/positiveInteger" }
  },
  "allOf": [
    {
      "if": { "required": ["TLS_CERT_FILE"] },
      "then": { "required": ["TLS_KEY_FILE"] }
    },
    {
      "if": { "required": ["TLS_KEY_FILE"] },
      "then": { "required": ["TLS_CERT_FILE"] }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "booleanFlag": { "type": "string", "enum": ["0", "1"] },
    "path": { "type": "string", "minLength": 1 },
    "port": { "type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$" },
    "positiveInteger": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "secret8": { "type": "string", "minLength": 8 },
    "secret16": { "type": "string", "minLength": 16 },
    "secret32": { "type": "string", "minLength": 32 }
  }
}
