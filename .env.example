# HK Gateway
PORT=8787
HOST=0.0.0.0
APP_TOKEN=replace-with-a-long-random-token
CONNECTOR_TOKEN=replace-with-a-different-long-random-token
# Set both paths in production to serve HTTPS/WSS directly.
# TLS_CERT_FILE=/etc/letsencrypt/live/example/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example/privkey.pem

# macOS Connector
GATEWAY_URL=ws://127.0.0.1:8787/v1/connect
DEVICE_ID=mac-mini
HERMES_MODE=mock
HERMES_CHAT_URL=http://127.0.0.1:9119/api/chat
