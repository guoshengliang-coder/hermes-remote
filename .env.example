# HK Gateway
PORT=8787
HOST=0.0.0.0
APP_TOKEN=replace-with-a-long-random-token
CONNECTOR_TOKEN=replace-with-a-different-long-random-token
# Set both paths in production to serve HTTPS/WSS directly.
# TLS_CERT_FILE=/etc/letsencrypt/live/example/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example/privkey.pem
DEFAULT_DEVICE_ID=mac-mini
MAX_BODY_BYTES=10485760
MAX_PENDING_REQUESTS=128
MAX_WS_TUNNELS=32
MAX_CONTROL_CONNECTIONS=32

# Account and binding control planes are independent and remain off until their release gates pass.
ACCOUNT_AUTH_ENABLED=0
ACCOUNT_BINDING_ENABLED=0
# ACCOUNT_DATABASE_URL=postgresql://account-service@127.0.0.1/hermes_go
# ACCOUNT_TOKEN_HASH_KEY=replace-with-at-least-32-random-bytes
# ACCOUNT_GOOGLE_ANDROID_CLIENT_ID=replace-with-google-android-client-id
# ACCOUNT_GOOGLE_MACOS_CLIENT_ID=replace-with-google-macos-client-id

# Public Desktop build/runtime configuration. The Google OAuth client ID is an identifier, not a
# client secret. Leave it unset in default-off compatibility builds.
# HERMES_GO_ACCOUNT_GATEWAY_URL=https://mrlgs.net
# HERMES_GO_GOOGLE_MACOS_CLIENT_ID=replace-with-google-macos-client-id
# Exact public origin included in Connector V2 signatures; required only when binding is enabled.
# ACCOUNT_GATEWAY_ORIGIN=https://example.invalid
ACCOUNT_MAX_PENDING_CONNECTOR_PROOFS=256
ACCOUNT_MAX_UNAUTHENTICATED_CONNECTORS=16
ACCOUNT_MAX_UNAUTHENTICATED_CONNECTORS_PER_IP=4
MAX_ACCOUNT_LIFECYCLE_EVENTS=10000

# macOS Connector
GATEWAY_URL=ws://127.0.0.1:8787/v1/connect
DEVICE_ID=mac-mini
HERMES_MODE=mock
HERMES_BASE_URL=http://127.0.0.1:9119
# Use either a loopback session token or the Basic Auth pair, never commit real values.
# HERMES_SESSION_TOKEN=replace-with-local-dashboard-token
# HERMES_BASIC_AUTH_USERNAME=replace-with-dashboard-user
# HERMES_BASIC_AUTH_PASSWORD=replace-with-dashboard-password
HERMES_CHAT_URL=http://127.0.0.1:9119/api/chat
# Phone uploads are transient, bounded files under FILES_ROOT; Connector responses stream in
# acknowledged chunks instead of Base64-encoding the complete HTTP response at once.
FILES_ROOT=/Users/example
UPLOAD_ROOT=/Users/example/.hermes-remote/uploads
MAX_UPLOAD_BYTES=6291456
MAX_FILE_BYTES=104857600
MAX_UPLOAD_CACHE_BYTES=536870912
MAX_UPLOAD_CACHE_FILES=200
UPLOAD_RETENTION_HOURS=168
