{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrlgs.net/schemas/hermes-go-production-account-rollout-config.schema.json",
  "title": "Hermes GO production email-account rollout configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "productionReleaseConfig", "host", "database", "gateway", "secrets", "deployment"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "production" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "productionReleaseConfig": { "$ref": "#/$defs/absolutePath" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "architecture"],
      "properties": {
        "hostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
        "architecture": { "const": "amd64" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssl", "migrationLockId"],
      "properties": {
        "ssl": { "type": "boolean" },
        "migrationLockId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "emailIssuer", "emailFromDomain", "trustLoopbackProxy"],
      "properties": {
        "origin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "emailIssuer": { "type": "string", "format": "uri", "pattern": "^https://" },
        "emailFromDomain": { "type": "string", "minLength": 1, "maxLength": 253 },
        "trustLoopbackProxy": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountDatabaseUrlSource", "accountTokenHashKeySource", "accountEmailOtpHashKeySource", "resendApiKeySource", "resendWebhookSecretSource", "emailFromSource"],
      "properties": {
        "accountDatabaseUrlSource": { "$ref": "#/$defs/absolutePath" },
        "accountTokenHashKeySource": { "$ref": "#/$defs/absolutePath" },
        "accountEmailOtpHashKeySource": { "$ref": "#/$defs/absolutePath" },
        "resendApiKeySource": { "$ref": "#/$defs/absolutePath" },
        "resendWebhookSecretSource": { "$ref": "#/$defs/absolutePath" },
        "emailFromSource": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationSeconds"],
      "properties": {
        "observationSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" }
  }
}
