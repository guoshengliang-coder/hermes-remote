{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrlgs.net/schemas/hermes-go-production-schema-release-config.schema.json",
  "title": "Hermes GO R5-F8 schema-changing production release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "productionReleaseConfig", "database", "backup"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "production" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "productionReleaseConfig": { "$ref": "#/$defs/path" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urlSource", "ssl", "migrationLockId"],
      "properties": {
        "urlSource": { "$ref": "#/$defs/path" },
        "ssl": { "type": "boolean" },
        "migrationLockId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeStatusFile", "maximumAgeMinutes"],
      "properties": {
        "activeStatusFile": { "$ref": "#/$defs/path" },
        "maximumAgeMinutes": { "type": "integer", "minimum": 5, "maximum": 720 }
      }
    },
    "schemaAdvancePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromSchemaVersion",
        "toSchemaVersion",
        "sourceCommit",
        "targetSourceCommit",
        "targetImageId",
        "targetArchiveSha256",
        "migrations",
        "rehearsalEvidenceFile"
      ],
      "properties": {
        "fromSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "toSchemaVersion": {
          "type": "integer",
          "minimum": 3
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "targetSourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "rehearsalEvidenceFile": {
          "$ref": "#/$defs/path"
        },
        "migrations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fileName",
              "sha256"
            ],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[0-9]{3}_gateway_schema_state[.]sql$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "targetImageId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "targetArchiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" }
  }
}
