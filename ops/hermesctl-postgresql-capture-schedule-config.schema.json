{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrlgs.net/schemas/hermesctl-postgresql-capture-schedule-config.schema.json",
  "title": "Hermes GO PostgreSQL daily capture configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "sourceHostname", "serviceName", "databaseUrlFile", "recipientCertificate", "backupRoot", "latestDescriptorFile", "activeStatusFile", "maximumEncryptedBytes", "retentionCount", "postgresqlMajorVersion", "databaseSchemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "production" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "sourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "serviceName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9@.-]{0,62}$" },
    "databaseUrlFile": { "$ref": "#/$defs/path" },
    "recipientCertificate": { "$ref": "#/$defs/path" },
    "backupRoot": { "$ref": "#/$defs/path" },
    "latestDescriptorFile": { "$ref": "#/$defs/path" },
    "activeStatusFile": { "$ref": "#/$defs/path" },
    "maximumEncryptedBytes": { "type": "integer", "minimum": 1024, "maximum": 1099511627776 },
    "retentionCount": { "type": "integer", "minimum": 2, "maximum": 365 },
    "postgresqlMajorVersion": { "const": 18 },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1 }
  },
  "$defs": { "path": { "type": "string", "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]+$" } }
}
