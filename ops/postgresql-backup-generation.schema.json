{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mrlgs.net/schemas/postgresql-backup-generation.schema.json",
  "title": "Hermes GO completed PostgreSQL backup generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generationId", "sourceHostname", "createdAt", "archiveSha256", "archiveBytes", "postgresqlMajorVersion", "databaseSchemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hermes-go-postgresql-backup-generation-v1" },
    "generationId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z-[0-9a-f]{12}$" },
    "sourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveBytes": { "type": "integer", "minimum": 1 },
    "postgresqlMajorVersion": { "const": 18 },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1 }
  }
}
