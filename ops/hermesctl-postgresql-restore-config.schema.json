{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-go.invalid/schemas/postgresql-restore-config-v1.json",
  "title": "Hermes GO isolated off-host PostgreSQL restore verification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "expectedSourceHostname", "archiveFile", "manifestFile", "recipientCertificate", "recipientPrivateKey", "databaseUrlFile", "imageDatabaseUrlFile", "targetImage", "targetImageId", "evidenceFile", "statusFile", "offHostStorageId", "postgresqlMajorVersion", "databaseSchemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "isolated-restore" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "expectedSourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "archiveFile": { "$ref": "#/$defs/absolutePath" },
    "manifestFile": { "$ref": "#/$defs/absolutePath" },
    "recipientCertificate": { "$ref": "#/$defs/absolutePath" },
    "recipientPrivateKey": { "$ref": "#/$defs/absolutePath" },
    "databaseUrlFile": { "$ref": "#/$defs/absolutePath" },
    "imageDatabaseUrlFile": { "$ref": "#/$defs/absolutePath" },
    "targetImage": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]{1,255}$" },
    "targetImageId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidenceFile": { "$ref": "#/$defs/absolutePath" },
    "statusFile": { "$ref": "#/$defs/absolutePath" },
    "offHostStorageId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "postgresqlMajorVersion": { "const": 18 },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  },
  "$defs": { "absolutePath": { "type": "string", "pattern": "^/(?!/)[^\\u0000-\\u001f\\u007f]+$" } }
}
