{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-go.invalid/schemas/hermesctl-legacy-capture-config-v1.json",
  "title": "Hermes GO encrypted legacy Gateway capture configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "sourceHostname", "service", "recipientCertificate", "archiveFile", "manifestFile", "maximumTotalBytes", "roots", "identityFiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "production" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "sourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "workingDirectory", "entrypoint", "environmentFile", "healthPath", "authenticatedPath"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$" },
        "workingDirectory": { "$ref": "#/$defs/absolutePath" },
        "entrypoint": { "$ref": "#/$defs/absolutePath" },
        "environmentFile": { "$ref": "#/$defs/absolutePath" },
        "healthPath": { "type": "string", "pattern": "^/" },
        "authenticatedPath": { "type": "string", "pattern": "^/" }
      }
    },
    "recipientCertificate": { "$ref": "#/$defs/absolutePath" },
    "archiveFile": { "$ref": "#/$defs/absolutePath" },
    "manifestFile": { "$ref": "#/$defs/absolutePath" },
    "maximumTotalBytes": { "type": "integer", "minimum": 1024, "maximum": 8589934592 },
    "roots": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": { "enum": ["configuration", "lifecycle", "nginx", "runtime", "systemd"] },
          "path": { "$ref": "#/$defs/absolutePath" }
        }
      }
    },
    "identityFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/absolutePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$" }
  }
}
