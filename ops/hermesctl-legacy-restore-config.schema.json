{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-go.invalid/schemas/hermesctl-legacy-restore-config-v1.json",
  "title": "Hermes GO isolated legacy Gateway restore verification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "operator", "expectedSourceHostname", "archiveFile", "manifestFile", "recipientCertificate", "recipientPrivateKey", "restoreRoot", "listenPort", "evidenceFile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "isolated-restore" },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "expectedSourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "archiveFile": { "$ref": "#/$defs/absolutePath" },
    "manifestFile": { "$ref": "#/$defs/absolutePath" },
    "recipientCertificate": { "$ref": "#/$defs/absolutePath" },
    "recipientPrivateKey": { "$ref": "#/$defs/absolutePath" },
    "restoreRoot": { "$ref": "#/$defs/absolutePath" },
    "listenPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "evidenceFile": { "$ref": "#/$defs/absolutePath" }
  },
  "$defs": {
    "absolutePath": { "type": "string", "pattern": "^/[^\\u0000-\\u001f\\u007f]+$" }
  }
}
