{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-go.invalid/schemas/postgresql-backup-manifest-v1.json",
  "title": "Hermes GO encrypted PostgreSQL backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "sourceHostname", "createdAt", "archiveSha256", "archiveBytes", "encryption", "postgresqlMajorVersion", "databaseSchemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hermes-go-postgresql-backup-v1" },
    "sourceHostname": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "archiveBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recipientCertificateSha256"],
      "properties": {
        "kind": { "const": "openssl-cms-auth-enveloped-aes-256-gcm" },
        "recipientCertificateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "postgresqlMajorVersion": { "type": "integer", "minimum": 1, "maximum": 99 },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  }
}
