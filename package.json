{
  "name": "hermes-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Android-to-Hermes relay through an HK gateway and macOS connector",
  "workspaces": [
    "gateway",
    "connector",
    "protocol"
    ,"release-server"
  ],
  "scripts": {
    "build": "npm run build -w @hermes-remote/protocol && npm run build -w @hermes-remote/gateway && npm run build -w @hermes-remote/connector",
    "test": "npm run test -w @hermes-remote/protocol && npm run test -w @hermes-remote/connector && npm run test -w @hermes-remote/gateway && npm run test -w @hermes-remote/release-server && npm run test:scripts",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "desktop:build": "swift build --package-path desktop",
    "desktop:test": "swift test --package-path desktop",
    "desktop:app": "./desktop/scripts/build-app.sh",
    "desktop:dmg": "./desktop/scripts/build-dmg.sh",
    "desktop:assets:test": "cmp android/app/src/main/ic_launcher-playstore.png desktop/Packaging/AppIcon.png",
    "smoke": "node scripts/smoke-client.mjs",
    "smoke:compat": "node scripts/smoke-compat-client.mjs",
    "mock:hermes": "node scripts/mock-hermes.mjs",
    "ops:preflight": "node scripts/hermesctl.mjs preflight",
    "ops:bootstrap": "node scripts/hermesctl.mjs bootstrap",
    "ops:status": "node scripts/hermesctl.mjs status",
    "ops:doctor": "node scripts/hermesctl.mjs doctor",
    "ops:deploy": "node scripts/hermesctl.mjs deploy",
    "ops:rollback": "node scripts/hermesctl.mjs rollback",
    "dev:gateway": "npm run dev -w @hermes-remote/gateway",
    "dev:connector": "npm run dev -w @hermes-remote/connector"
  },
  "engines": {
    "node": ">=20"
  }
}
