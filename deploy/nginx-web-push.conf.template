# Optional HG-191 Web Push route. Install only during an explicitly authorized rollout.
# Existing Android FCM and Web routes remain in their original includes.
location = /v2/web/push-subscription {
    client_max_body_size 8k;
    proxy_pass http://hermes_go_gateway_production;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
}
