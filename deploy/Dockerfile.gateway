FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY protocol/package.json protocol/tsconfig.json ./protocol/
COPY protocol/src ./protocol/src
COPY gateway/package.json gateway/tsconfig.json ./gateway/
COPY gateway/src ./gateway/src
RUN npm install && npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json* ./
COPY --from=build /app/protocol/package.json ./protocol/
COPY --from=build /app/protocol/dist ./protocol/dist
COPY --from=build /app/gateway/package.json ./gateway/
COPY --from=build /app/gateway/dist ./gateway/dist
RUN npm install --omit=dev
EXPOSE 8787
CMD ["node", "gateway/dist/index.js"]
