#!/bin/sh
set -eu

set -a
. "__INSTALL_DIR__/connector.env"
set +a

dotenv_value() {
  sed -n "s/^$1=//p" "$HOME/.hermes/.env" | tail -n 1
}

HERMES_BASIC_AUTH_USERNAME="$(dotenv_value HERMES_DASHBOARD_BASIC_AUTH_USERNAME)"
HERMES_BASIC_AUTH_PASSWORD="$(dotenv_value HERMES_DASHBOARD_BASIC_AUTH_PASSWORD)"
: "${HERMES_BASIC_AUTH_USERNAME:?missing Hermes dashboard username}"
: "${HERMES_BASIC_AUTH_PASSWORD:?missing Hermes dashboard password}"
export HERMES_BASIC_AUTH_USERNAME HERMES_BASIC_AUTH_PASSWORD

exec "__NODE_BIN__" "__INSTALL_DIR__/connector/dist/index.js"
