[Unit]
Description=Hermes Remote HK Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-remote
Group=hermes-remote
WorkingDirectory=/opt/hermes-remote
EnvironmentFile=/etc/hermes-remote/gateway.env
StateDirectory=hermes-remote
ExecStart=/usr/bin/node /opt/hermes-remote/gateway/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-remote
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
