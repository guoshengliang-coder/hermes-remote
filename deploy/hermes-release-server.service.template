[Unit]
Description=Hermes Remote HTTPS release repository
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kkk
Group=kkk
EnvironmentFile=/etc/hermes-release-server/environment
ExecStart=/usr/bin/node /opt/hermes-release-server/release-server/src/server.mjs
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Node/V8 JIT allocates executable memory; MemoryDenyWriteExecute crashes the process.
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/srv/hermes-releases
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
